{
  "name": "stem-ecommerce",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,green \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:frontend": "yarn --cwd frontend dev",
    "dev:backend": "yarn --cwd backend/apps/backend run dev",
    "migrate": "yarn --cwd backend/apps/backend run migrate",
    "seed": "yarn --cwd backend/apps/backend run seed",
    "db:start": "docker compose -f backend/docker-compose.yml up -d",
    "db:stop": "docker compose -f backend/docker-compose.yml down",
    "install:all": "yarn install && yarn --cwd frontend install && yarn --cwd backend install"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
